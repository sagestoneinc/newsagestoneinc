# ─── Contact Form Email (Mailgun) ────────────────────────────────
# These secrets must be set in the Cloudflare Pages dashboard:
#   Settings → Environment variables → Add variable (encrypt)
#
# MAILGUN_API_KEY        – Your Mailgun private API key (REQUIRED, set as encrypted secret)
# MAILGUN_DOMAIN         – Your verified Mailgun sending domain, e.g. sagestoneinc.com
# MAILGUN_FROM_EMAIL     – Sender address on the verified domain, e.g. hello@sagestoneinc.com
# MAILGUN_REGION         – "us" (default) or "eu" — match your Mailgun account region

MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=sagestoneinc.com
MAILGUN_FROM_EMAIL=postmaster@sagestoneinc.com
MAILGUN_REGION=us
