# ─── Contact Form Email (SendGrid) ───────────────────────────────
# These secrets must be set in the Cloudflare Pages dashboard:
#   Settings → Environment variables → Add variable (encrypt)
#
# SENDGRID_API_KEY       – Your SendGrid API key (starts with SG.)
# SENDGRID_FROM_EMAIL    – Verified sender email, e.g. noreply@sagestoneinc.com

SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@sagestoneinc.com
