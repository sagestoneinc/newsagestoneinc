# ─── Contact Form Email (Cloudflare Email Routing) ────────────────
# The send_email binding is configured in wrangler.toml.
# Ensure Cloudflare Email Routing is enabled for your domain
# in the Cloudflare dashboard under Email → Email Routing.
#
# FROM_EMAIL  – Sender address on the verified domain (set in wrangler.toml [vars])

FROM_EMAIL=noreply@sagestoneinc.com
